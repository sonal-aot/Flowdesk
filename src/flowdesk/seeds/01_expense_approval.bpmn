<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
  id="Definitions_expense" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_expense">
    <bpmn:participant id="Participant_expense" name="Expense Approval" processRef="Process_expense_approval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_expense_approval" name="Expense Approval" isExecutable="true">
    <bpmn:laneSet id="LaneSet_expense">
      <bpmn:lane id="Lane_submitter" name="Submitter">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_auto_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_approver" name="Approver">
        <bpmn:flowNodeRef>task_approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="start" name="Expense claimed">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="task_submit" name="Submit Expense Claim">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="submit-expense.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:businessRuleTask id="task_route" name="Check Approval Threshold">
      <bpmn:extensionElements>
        <spiffworkflow:calledDecisionId>expense_route</spiffworkflow:calledDecisionId>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="gateway_route" name="Approval needed?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f_needs</bpmn:outgoing>
      <bpmn:outgoing>f_auto</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="task_approve" name="Approve Expense Claim">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="approve-expense.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>f_needs</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:scriptTask id="task_auto_ok" name="Approve Under Threshold">
      <bpmn:script>decision = "approved"
approved_by = "policy"</bpmn:script>
      <bpmn:incoming>f_auto</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:scriptTask>

    <bpmn:serviceTask id="task_record" name="Record In Ledger">
      <bpmn:extensionElements>
        <spiffworkflow:serviceTaskOperator id="log/Write">
          <spiffworkflow:parameters>
            <spiffworkflow:parameter id="ledger_entry" type="any" value="&#34;expense &#34; + str(amount) + &#34; for &#34; + purpose" />
            <spiffworkflow:parameter id="outcome" type="any" value="decision" />
          </spiffworkflow:parameters>
        </spiffworkflow:serviceTaskOperator>
      </bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="end_done" name="Recorded">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="task_submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_submit" targetRef="task_route" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_route" targetRef="gateway_route" />
    <bpmn:sequenceFlow id="f_needs" name="Over threshold" sourceRef="gateway_route" targetRef="task_approve">
      <bpmn:conditionExpression>needs_approval == True</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_auto" name="Within policy" sourceRef="gateway_route" targetRef="task_auto_ok">
      <bpmn:conditionExpression>needs_approval == False</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="task_approve" targetRef="task_record" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_auto_ok" targetRef="task_record" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_record" targetRef="end_done" />
  </bpmn:process>
</bpmn:definitions>
